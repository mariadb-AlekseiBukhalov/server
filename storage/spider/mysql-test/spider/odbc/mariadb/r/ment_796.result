CREATE SERVER srv FOREIGN DATA WRAPPER ODBC OPTIONS
(
Driver "MariaDB ODBC 3.0 Driver",
Host "255.255.255.255",
Database "test",
Password "",
Port $MASTER_1_MYPORT
);
select Options from mysql.servers where Server_name = "srv";
Options
{"Driver": "MariaDB ODBC 3.0 Driver", "Host": "255.255.255.255", "Database": "test", "Password": "", "Port": "MASTER_1_MYPORT"}
ALTER SERVER srv OPTIONS (HOST "127.0.0.1", User "root");
select Options from mysql.servers where Server_name = "srv";
Options
{"Driver": "MariaDB ODBC 3.0 Driver", "Database": "test", "Password": "", "Port": "MASTER_1_MYPORT", "HOST": "127.0.0.1", "User": "root"}
SELECT spider_direct_sql('DROP TABLE IF EXISTS `t2`', '',
'srv "srv", wrapper "odbc"');
spider_direct_sql('DROP TABLE IF EXISTS `t2`', '',
'srv "srv", wrapper "odbc"')
1
SELECT spider_direct_sql('CREATE TABLE `t2` (`c` INT)', '',
'srv "srv", wrapper "odbc"');
spider_direct_sql('CREATE TABLE `t2` (`c` INT)', '',
'srv "srv", wrapper "odbc"')
1
create table t1 (c int) ENGINE=Spider
WRAPPER=odbc REMOTE_TABLE=t2 REMOTE_SERVER=srv;
INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
