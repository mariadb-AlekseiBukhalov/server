for master_1
for child2
for child3
SELECT * INTO OUTFILE '$dsn_file' FROM (
SELECT '[ODBC]' UNION ALL
SELECT 'Driver=MariaDB ODBC 3.0 Driver' UNION ALL
SELECT 'Servername=127.0.0.1' UNION ALL
SELECT 'Database=test' UNION ALL
SELECT 'User=root' UNION ALL
SELECT 'Password=' UNION ALL
SELECT 'Port=$MASTER_1_MYPORT'
) a;
create table t2 (c int, t varchar(100) Default  @@session.tx_isolation);
create table t1 (c int) ENGINE=Spider
COMMENT='WRAPPER "odbc_mariadb", TABLE "t2", filedsn "$dsn_file"';
SET SESSION spider_sync_trx_isolation=on;
INSERT INTO t1 VALUES (1);
set @@session.tx_isolation= 'SERIALIZABLE';
INSERT INTO t1 VALUES (2);
set @@session.tx_isolation= 'READ-UNCOMMITTED';
INSERT INTO t1 VALUES (3);
SET @saved_dbug = @@SESSION.debug_dbug;
SET debug_dbug="+d,spd_odbc_isolation_level_serializable";
INSERT INTO t1 VALUES (4);
SET debug_dbug= @saved_dbug;
SELECT * FROM t2 ORDER BY c;
c	t
1	REPEATABLE-READ
2	SERIALIZABLE
3	READ-UNCOMMITTED
4	SERIALIZABLE
drop table t1, t2;
set @@session.tx_isolation= Default;
SET SESSION spider_sync_trx_isolation= Default;
for master_1
for child2
