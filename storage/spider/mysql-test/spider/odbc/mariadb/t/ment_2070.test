--disable_query_log
--disable_result_log
--source ../../t/test_init.inc
--enable_result_log
--enable_query_log

create table t2 (c int, key(c));
evalp create table t1 (c int, key(c))
ENGINE=Spider WRAPPER=odbc REMOTE_TABLE=t2
CONNECTION='Driver=MariaDB ODBC 3.0 Driver;Database=test;UID=root;PWD=;SERVER=127.0.0.1;PORT=$MASTER_1_MYPORT';

INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

# restart the server to check CONNECTION string is recovered
--source include/restart_mysqld.inc
truncate table t1;
INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

drop table t1, t2;

--disable_query_log
--disable_result_log
--source ../../t/test_deinit.inc
--enable_result_log
--enable_query_log
