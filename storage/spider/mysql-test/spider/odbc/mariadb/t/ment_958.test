--disable_query_log
--disable_result_log
--source ../../../t/test_init.inc
--enable_result_log
--enable_query_log

let $dsn_file=$MYSQLTEST_VARDIR/tmp/filedsn.dsn;
evalp SELECT * INTO OUTFILE '$dsn_file' FROM (
  SELECT '[ODBC]' UNION ALL
  SELECT 'Driver=MariaDB ODBC 3.0 Driver' UNION ALL
  SELECT 'Servername=127.0.0.1' UNION ALL
  SELECT 'Database=test' UNION ALL
  SELECT 'User=root' UNION ALL
  SELECT 'Password=' UNION ALL
  SELECT 'Port=$MASTER_1_MYPORT'
) a;

create table t2 (c int, key(c));
evalp create table t1 (c int, key(c)) ENGINE=Spider
COMMENT='WRAPPER "odbc", TABLE "t2", filedsn "$dsn_file"';

# trigger append_key_select_sql_part() or
# append_table_select_sql_part()
set spider_select_column_mode= 0;
select * from t1;

INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

# trigger the table cache hit in insert so that a new connection needs
# to be established at the time of appending to call SQLGetInfo
truncate table t1;
INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

drop table t1, t2;
remove_file $dsn_file;

--disable_query_log
--disable_result_log
--source ../../../t/test_deinit.inc
--enable_result_log
--enable_query_log
