--disable_query_log
--disable_result_log
--source ../../../t/test_init.inc
--enable_result_log
--enable_query_log

# Basic test of create and alter server
evalp CREATE SERVER srv FOREIGN DATA WRAPPER ODBC OPTIONS
(
  Driver "MariaDB ODBC 3.0 Driver",
  Servername "255.255.255.255",
  Database "test",
  Password "",
  Port $MASTER_1_MYPORT
);

replace_result $MASTER_1_MYPORT MASTER_1_MYPORT;
select Options from mysql.servers where Server_name = "srv";
replace_result $MASTER_1_MYPORT MASTER_1_MYPORT;
ALTER SERVER srv OPTIONS (Servername "127.0.0.1", User "root");
replace_result $MASTER_1_MYPORT MASTER_1_MYPORT;
select Options from mysql.servers where Server_name = "srv";

evalp SELECT spider_direct_sql('DROP TABLE IF EXISTS `t2`', '',
'srv "srv", wrapper "odbc"');
evalp SELECT spider_direct_sql('CREATE TABLE `t2` (`c` INT)', '',
'srv "srv", wrapper "odbc"');
evalp create table t1 (c int) ENGINE=Spider
WRAPPER=odbc REMOTE_TABLE=t2 REMOTE_SERVER=srv;

INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

drop table t1, t2;
drop server srv;

# Test json escaping and unescaping
select priv into @root_priv from mysql.global_priv where user='root' and host='localhost';
evalp CREATE SERVER srv FOREIGN DATA WRAPPER ODBC OPTIONS
(
  Driver "MariaDB ODBC 3.0 Driver",
  Servername "127.0.0.1",
  User "root",
  Database "test",
  Password "",
  Port $MASTER_1_MYPORT
);
SET PASSWORD FOR 'root'@localhost = PASSWORD('"hello!!');
ALTER SERVER srv OPTIONS (Password '"hello!!');
replace_result $MASTER_1_MYPORT MASTER_1_MYPORT;
select Options from mysql.servers where Server_name = "srv";
evalp SELECT spider_direct_sql('DROP TABLE IF EXISTS `t2`', '',
'srv "srv", wrapper "odbc"');
evalp SELECT spider_direct_sql('CREATE TABLE `t2` (`c` INT)', '',
'srv "srv", wrapper "odbc"');
evalp create table t1 (c int) ENGINE=Spider
WRAPPER=odbc REMOTE_TABLE=t2 REMOTE_SERVER=srv;
INSERT INTO t1 VALUES (1), (2), (3);
select * from t2;
select * from t1;

drop table t1, t2;
drop server srv;
SET PASSWORD FOR 'root'@localhost = PASSWORD('');
update mysql.global_priv set priv=@root_priv where user='root' and host='localhost';

--disable_query_log
--disable_result_log
--source ../../../t/test_deinit.inc
--enable_result_log
--enable_query_log
