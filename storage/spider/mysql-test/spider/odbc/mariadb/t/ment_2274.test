--disable_query_log
--disable_result_log
--source ../../t/test_init.inc
--enable_result_log
--enable_query_log

CREATE SERVER srv FOREIGN DATA WRAPPER odbc OPTIONS (DRIVER '',USERNAME '',PASSWORD '',PORT 0,DATABASE 'foo');
CREATE TABLE t (c INT) ENGINE=Spider COMMENT='WRAPPER "mysql",SRV "srv",TABLE "nonexisting"';
--error ER_CONNECT_TO_FOREIGN_DATA_SOURCE
SELECT * FROM t;
drop table t;
drop server srv;

--disable_query_log
--disable_result_log
--source ../../t/test_deinit.inc
--enable_result_log
--enable_query_log
