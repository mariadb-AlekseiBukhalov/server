--disable_query_log
--source ../include/init_odbc_oracle.inc
--enable_query_log

# Spider node setup
CREATE TABLE t1 (a INT) ENGINE=SPIDER COMMENT='wrapper "odbc", dsn "ora", table "t1"';

# Oracle node setup
CALL ORACLE_DROP_TABLE_IF_EXISTS("t1");
SELECT spider_direct_sql('CREATE TABLE "t1" ("a" INT)', '', 'dsn "ora", wrapper "odbc"');

# Test body
SELECT * FROM t1 ORDER BY a;

INSERT INTO t1 VALUES (1), (2), (3);
SELECT * FROM t1 ORDER BY a;

UPDATE t1 SET a = 5 WHERE a = 2;
SELECT * FROM t1 ORDER BY a;

DELETE FROM t1 WHERE a = 3;
SELECT * FROM t1 ORDER BY a;

# clean up
DROP TABLE t1;
SELECT spider_direct_sql('DROP TABLE "t1"', '', 'dsn "ora", wrapper "odbc"');

--disable_query_log
--source ../include/deinit_odbc_oracle.inc
--enable_query_log
