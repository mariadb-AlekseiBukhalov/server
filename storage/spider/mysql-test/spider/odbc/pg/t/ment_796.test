--disable_query_log
--disable_result_log
--source ../../../t/test_init.inc
--enable_result_log
--enable_query_log

create server srv foreign data wrapper odbc options
(driver 'PostgreSQL', username 'mtr', password 'mtr', port '5432',
 database 'auto_test_remote');

--disable_result_log
--disable_warnings
SELECT spider_direct_sql('DROP TABLE IF EXISTS "t796"', '',
'srv "srv", wrapper "odbc"');
--enable_warnings
--enable_result_log
SELECT spider_direct_sql('CREATE TABLE "t796" ("c" INT)', '',
'srv "srv", wrapper "odbc"');
create table t1 (c int) ENGINE=Spider
WRAPPER=odbc REMOTE_TABLE=t796 REMOTE_SERVER=srv;

INSERT INTO t1 VALUES (1), (2), (3);
select * from t1;

drop table t1;
SELECT spider_direct_sql('DROP TABLE "t796"', '',
'srv "srv", wrapper "odbc"');
drop server srv;

--disable_query_log
--disable_result_log
--source ../../../t/test_deinit.inc
--enable_result_log
--enable_query_log
