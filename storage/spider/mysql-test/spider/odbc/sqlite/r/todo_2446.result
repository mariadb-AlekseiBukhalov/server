SELECT * INTO OUTFILE '$dsn_file' FROM (
SELECT '[ODBC]' UNION ALL
SELECT 'Driver=SQLite3' UNION ALL
SELECT 'Servername=127.0.0.1' UNION ALL
SELECT 'Database=$db_file'
) a;
SELECT spider_direct_sql('DROP TABLE IF EXISTS "t2"', '',
'filedsn "$dsn_file", wrapper "odbc"');
spider_direct_sql('DROP TABLE IF EXISTS "t2"', '',
'filedsn "dsn_file", wrapper "odbc"')
1
SELECT spider_direct_sql('CREATE TABLE "t2" ("c" INT)', '',
'filedsn "$dsn_file", wrapper "odbc"');
spider_direct_sql('CREATE TABLE "t2" ("c" INT)', '',
'filedsn "dsn_file", wrapper "odbc"')
1
create table t1 (c int) ENGINE=Spider
COMMENT='WRAPPER "odbc", TABLE "t2", filedsn "$dsn_file"';
