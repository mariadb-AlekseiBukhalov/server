--source include/have_wsrep.inc
--source include/have_innodb.inc

SELECT @@wsrep_on;

select variable_type, global_value from information_schema.system_variables where variable_name = 'wsrep_provider%';

--echo # Table structure is visible
show create table information_schema.wsrep_bf_abort_history;
--echo # But table is not there
--error ER_NO_SUCH_TABLE
select * from information_schema.wsrep_bf_abort_history;
