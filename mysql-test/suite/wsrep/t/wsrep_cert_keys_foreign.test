# Verify that wsrep keys are collected for foregin keys. This test requires
# wsrep_info plugin to be loaded. The plugin is loaded in suite level my.cnf.
--source include/have_wsrep.inc
--source include/have_wsrep_provider.inc
--source include/have_innodb.inc

# Test with TINYINT
CREATE TABLE parent (f1 TINYINT PRIMARY KEY, f2 TINYINT);
CREATE TABLE child (f1 TINYINT PRIMARY KEY, f2 TINYINT,
    FOREIGN KEY (f2) REFERENCES parent(f1));
START TRANSACTION;
INSERT INTO parent VALUES (1, 2);
INSERT INTO child VALUES (10, 1);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE child;
DROP TABLE parent;

