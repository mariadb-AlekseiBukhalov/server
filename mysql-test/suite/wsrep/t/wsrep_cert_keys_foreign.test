# Test with composite foreign key (INT and VARCHAR)
CREATE TABLE parent (f1 INT, f2 VARCHAR(10), f3 INT, PRIMARY KEY (f1, f2));
CREATE TABLE child (f1 INT PRIMARY KEY, f2 INT, f3 VARCHAR(10),
    FOREIGN KEY (f2, f3) REFERENCES parent(f1, f2));
START TRANSACTION;
INSERT INTO parent VALUES (1, 'test1', 3);
INSERT INTO child VALUES (10, 1, 'test1');
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE child;
DROP TABLE parent;

# Test with composite foreign key (INT and VARCHAR) and unique key reference
CREATE TABLE parent (f1 INT PRIMARY KEY, f2 VARCHAR(10), f3 INT, UNIQUE KEY (f2, f3));
CREATE TABLE child (f1 INT PRIMARY KEY, f2 VARCHAR(10), f3 INT,
    FOREIGN KEY (f2, f3) REFERENCES parent(f2, f3));
START TRANSACTION;
INSERT INTO parent VALUES (1, 'test1', 3);
INSERT INTO child VALUES (10, 'test1', 3);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE child;
DROP TABLE parent;
