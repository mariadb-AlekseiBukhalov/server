# Verify that wsrep keys are collected. This test requires wsrep_info
# plugin to be loaded. The plugin is loaded in suite level my.cnf.
--source include/have_wsrep.inc
--source include/have_wsrep_provider.inc
--source include/have_innodb.inc

SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;

# Test with TINYINT
CREATE TABLE t1 (f1 TINYINT PRIMARY KEY, f2 TINYINT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES (1, 2);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Test with SMALLINT
CREATE TABLE t1 (f1 SMALLINT PRIMARY KEY, f2 SMALLINT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES (1, 2);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

