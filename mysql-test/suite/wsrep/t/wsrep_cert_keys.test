# Test with TEXT (with prefix length)
CREATE TABLE t1 (f1 TEXT(100), f2 TEXT(100), PRIMARY KEY (f1(100))) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES ('test1', 'test2');
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Test with BLOB (with prefix length)
CREATE TABLE t1 (f1 BLOB(100), f2 BLOB(100), PRIMARY KEY (f1(100))) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES ('test1', 'test2');
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Test with JSON (using generated column for primary key)
CREATE TABLE t1 (f1 JSON, f2 JSON, 
    f1_key VARCHAR(255) AS (f1) PERSISTENT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 (f1, f2) VALUES (JSON_OBJECT('key', 'value1'), JSON_OBJECT('key', 'value2'));
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Test with composite primary key (INT and VARCHAR)
CREATE TABLE t1 (f1 INT, f2 VARCHAR(10), f3 INT, PRIMARY KEY (f1, f2)) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES (1, 'test1', 3);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Show history
# TODO: This is not deterministic, the output depends on the order of the
# tests are run.
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS_HISTORY WHERE THD_ID = CONNECTION_ID();
