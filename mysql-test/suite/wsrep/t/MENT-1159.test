--source include/have_wsrep.inc
--source include/have_innodb.inc

#
# Verify that setting variable wsrep_cluster_address
# is not allowed while XA transaction is in progress.
#
--connection default
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
XA START 'a';
INSERT INTO t1 VALUES (1);
XA END 'a';
XA PREPARE 'a';

--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET GLOBAL wsrep_cluster_address='gcomm://';

XA COMMIT 'a';
SELECT * FROM t1;

#
# Verify that setting variable wsrep_cluster_address
# (in different connection) is allowed, and that it
# does not cause prepared transaction to rollback.
#
--connection default
--enable_reconnect
XA START 'a';
INSERT INTO t1 VALUES (2);
XA END 'a';
XA PREPARE 'a';

--connect con_ctrl, localhost, root
--connection con_ctrl
SET GLOBAL wsrep_cluster_address='gcomm://';

--connection default
--source include/wait_until_connected_again.inc
XA COMMIT 'a';
SELECT * FROM t1;

DROP TABLE t1;
