# Verify that wsrep keys are collected for unique columns. This test requires
# wsrep_info plugin to be loaded. The plugin is loaded in suite level my.cnf.

--source include/have_wsrep.inc
--source include/have_wsrep_provider.inc
--source include/have_innodb.inc

# Test with TINYINT and unique index
CREATE TABLE t1 (f1 TINYINT PRIMARY KEY, f2 TINYINT UNIQUE) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES (1, 2);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

