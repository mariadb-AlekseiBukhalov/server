# Test with JSON and unique index (using generated column)
CREATE TABLE t1 (f1 JSON, f2 JSON, 
    f1_key VARCHAR(255) AS (f1) PERSISTENT) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 (f1, f2) VALUES (JSON_OBJECT('key', 'value1'), JSON_OBJECT('key', 'value2'));
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;

# Test with composite unique key (INT and VARCHAR)
CREATE TABLE t1 (f1 INT PRIMARY KEY, f2 VARCHAR(10), f3 INT, UNIQUE KEY (f2, f3)) ENGINE=InnoDB;
START TRANSACTION;
INSERT INTO t1 VALUES (1, 'test1', 3);
SELECT KEY_STRING, KEY_TYPE FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS;
COMMIT;
DROP TABLE t1;
