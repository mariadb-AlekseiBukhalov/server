#
# MENT-1744: Milliseconds for Timestamp of the Audit Log
#
SET GLOBAL server_audit_logging=on;
show variables like 'server_audit%';
Variable_name	Value
server_audit_file_path	server_audit.log
server_audit_file_rotate_now	OFF
server_audit_file_rotate_size	1000000
server_audit_file_rotations	9
server_audit_load_on_error	ON
server_audit_logging	ON
server_audit_mode	0
server_audit_output_type	file
server_audit_query_log_limit	1024
server_audit_reload_filters	OFF
server_audit_syslog_facility	LOG_USER
server_audit_syslog_ident	mysql-server_auditing
server_audit_syslog_info	
server_audit_syslog_priority	LOG_INFO
server_audit_timestamp_format	
# replaced the timestamp and the hostname with constant values
# Get only first 3 line from the audit log. ( It is enough to see what is logged )
,HOSTNAME,root,localhost,ID,0,AUDIT_CONFIG,test,file_path=server_audit.log,0
,HOSTNAME,root,localhost,ID,0,AUDIT_CONFIG,test,rotate_size=1000000,0
,HOSTNAME,root,localhost,ID,0,AUDIT_CONFIG,test,file_rotations=9,0
SET GLOBAL server_audit_logging=DEFAULT;
