#
# Verify that the wsrep-ssl-mode=SERVER_X509 works. For this we use
# certificates with common root CA. See galera_ssl_mode_x509 for
# configuration.
#
# We additionally check that when restarting the node with certificate
# without common CA, the joining fails.
#
# Not to be run with ASAN. Provider does not fully clean up itself
# in case of failure and ASAN fails with internal error while trying
# to process leaks from unloaded library.
#
# Marked as big test as the failing attempt to join the node will take
# long time.
#
--source include/not_asan.inc
--source include/big_test.inc
--source include/galera_cluster.inc
--source include/have_innodb.inc
--source include/have_openssl.inc

# Save original auto_increment_offset values.
--let $node_1=node_1
--let $node_2=node_2
--source include/auto_increment_offset_save.inc

--connection node_1
CREATE TABLE t1(a int not null primary key) engine=InnoDB;
INSERT INTO t1 VALUES (1);
SELECT COUNT(*) > 0 FROM performance_schema.socket_instances WHERE EVENT_NAME LIKE '%wsrep%' OR EVENT_NAME LIKE '%grp%';

--connection node_2
INSERT INTO t1 VALUES (2);
--echo # Shutdown node_2
--source include/shutdown_mysqld.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--error 1
--exec $MYSQLD --defaults-group-suffix=.2 --defaults-file=$MYSQLTEST_VARDIR/my.cnf --loose-ssl-key=$MYSQL_TEST_DIR/std_data/server-key.pem --loose-ssl-cert=$MYSQL_TEST_DIR/std_data/server-cert.pem --log-error=$MYSQL_TMP_DIR/galera_ssl_mode_server_x509.log

--echo # waiting to above command to fail
--sleep 5

--connection node_2
--echo # Restart node_2
--source include/start_mysqld.inc
--source include/wait_until_connected_again.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc

--connection node_2
INSERT INTO t1 VALUES (3);

--connection node_1
INSERT INTO t1 VALUES (4);
SELECT * FROM t1;

--connection node_2
INSERT INTO t1 VALUES (5);
DROP TABLE t1;

--let $assert_text= certificate verify failed
--let $assert_select= certificate verify failed
--let $assert_match= certificate verify failed
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--source include/assert_grep.inc

CALL mtr.add_suppression('WSREP:.* certificate verify failed');

# Restore original auto_increment_offset values.
--source include/auto_increment_offset_restore.inc
