#
# Verify that if server certificate is about to expire in
# wsrep_certificate_expiration_hours_warning, a new connection
# generates a warning.
#
--source include/not_asan.inc
--source include/big_test.inc
--source include/galera_cluster.inc
--source include/have_innodb.inc

SELECT COUNT(*) > 0 FROM performance_schema.socket_instances WHERE EVENT_NAME LIKE '%wsrep%';

# Save original auto_increment_offset values.
--let $node_1=node_1
--let $node_2=node_2
--source include/auto_increment_offset_save.inc

--connection node_2
--source include/shutdown_mysqld.inc
--connection node_1
SET GLOBAL wsrep_certificate_expiration_hours_warning=200000;

--connection node_2
--source include/start_mysqld.inc

--connection node_1
SET GLOBAL wsrep_certificate_expiration_hours_warning=DEFAULT;

--let $assert_text= certificate expiration warning: the peer certificate for
--let $assert_select= certificate expiration warning: the peer certificate for
--let $assert_match= certificate expiration warning: the peer certificate for
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--source include/assert_grep.inc

CALL mtr.add_suppression('WSREP:.* certificate expiration warning: the peer certificate for ');

# Restore original auto_increment_offset values.
--source include/auto_increment_offset_restore.inc
