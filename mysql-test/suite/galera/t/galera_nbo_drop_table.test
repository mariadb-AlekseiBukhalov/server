--source include/galera_cluster.inc

#
# Test DROP TABLE with NBO
#
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
SET SESSION wsrep_osu_method=NBO;
DROP TABLE t1;
SET SESSION wsrep_osu_method=DEFAULT;

#
# DROP multiple tables in the same statement
#
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
CREATE TABLE t2 (f1 INTEGER PRIMARY KEY);
CREATE TABLE t3 (f1 INTEGER PRIMARY KEY);
CREATE TABLE t4 (f1 INTEGER PRIMARY KEY);
SET SESSION wsrep_osu_method=NBO;
DROP TABLE t1, t2, t3, t4;
SET SESSION wsrep_osu_method=DEFAULT;


#
# DROP non-existing table
#
SET SESSION wsrep_osu_method=NBO;
--error ER_BAD_TABLE_ERROR
DROP TABLE t1;
SET SESSION wsrep_osu_method=DEFAULT;


#
# DROP multiple tables and a non-existing table in the same statement
#
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
CREATE TABLE t3 (f1 INTEGER PRIMARY KEY);
CREATE TABLE t4 (f1 INTEGER PRIMARY KEY);
SET SESSION wsrep_osu_method=NBO;
--error ER_BAD_TABLE_ERROR
DROP TABLE t1, t2, t3, t4;
SET SESSION wsrep_osu_method=DEFAULT;
