#
# Test various concurrent operations while DROP TABLE using NBO is in progress
#

--source include/galera_cluster.inc
--source include/have_debug_sync.inc
--source include/have_debug.inc

--connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1

--connection node_1
SET @save_debug= @@global.debug;

CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
INSERT INTO t1 VALUES (0);

#
# Issue a DROP TABLE on t1, and block at end of NBO phase 1
#
SET SESSION wsrep_osu_method=NBO;
SET GLOBAL debug_dbug = '+d,sync.wsrep_alter_locked_tables';

--connection node_1
--send DROP TABLE t1

--connection node_1a
SET DEBUG_SYNC = "now WAIT_FOR signal.wsrep_alter_locked_tables_reached";

#
# DROP TABLE t1 has now acquired MDL locks.
# It should be possible to execute non-MDL conflicting
# operations concurrently
#
CREATE TABLE t2 (f1 INTEGER PRIMARY KEY);
INSERT INTO t2 VALUES (1);
INSERT INTO t2 VALUES (2);
INSERT INTO t2 VALUES (3);

#
# Whereas attempting to access t1 will MDL-conflict, and timeout
#
SET SESSION lock_wait_timeout=1;

--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1;

--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t1 VALUES (1111);

--error ER_LOCK_DEADLOCK
DROP TABLE t1;

#
# Release DROP TABLE t1
#
SET GLOBAL debug_dbug = '-d,sync.wsrep_alter_locked_tables';
SET DEBUG_SYNC= 'now SIGNAL signal.wsrep_alter_locked_tables';

--connection node_1
--reap

#
# Cleanup
#
SET GLOBAL debug_dbug= @save_debug;
SET DEBUG_SYNC='RESET';
DROP TABLE t2;

--connection node_2
#
# We are using debug sync points and sometimes at lock_wait for table we
# report wait information on debug builds. This happens for NBO as
# it will not take similar MDL-locks as TOI
#
call mtr.add_suppression("WSREP: BF request is not compatible with victim");
call mtr.add_suppression("WSREP: BF requesting lock");
call mtr.add_suppression("WSREP: victim holding lock");
call mtr.add_suppression("InnoDB: WSREP state: ");
call mtr.add_suppression("WSREP: Thread ");
