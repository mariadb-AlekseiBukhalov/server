--source include/galera_cluster.inc
--source include/not_windows.inc
--source include/have_ssl_communication.inc

# Save original auto_increment_offset values.
--let $node_1=node_1
--let $node_2=node_2
--source include/auto_increment_offset_save.inc

--let $LOG_FILE_2=$MYSQLTEST_VARDIR/mysqld.2/error.log

--error 0,1
--remove_file $LOG_FILE_2

--connection node_2
--source include/shutdown_mysqld.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 1 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size';
--source include/wait_condition.inc

--connection node_2

--let $defaults=--defaults-group-suffix=.2 --defaults-file=$MYSQLTEST_VARDIR/my.cnf --log-error=$LOG_FILE_2
--error 1
--exec $MYSQLD $defaults --wsrep-ssl-mode=SERVER_X509 --ssl-cert="" --ssl-key="" --ssl-ca=""

#
# Force SST
#
--echo # cleaning data directory...
--remove_file $MYSQLTEST_VARDIR/mysqld.2/data/grastate.dat
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mtr
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/performance_schema
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/test
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data/mysql
--remove_files_wildcard $MYSQLTEST_VARDIR/mysqld.2/data

--let $_expect_file_name=$MYSQLTEST_VARDIR/tmp/mysqld.2.expect
--source ../../include/start_mysqld.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size';
--source include/wait_condition.inc

--connection node_2
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM INFORMATION_SCHEMA.GLOBAL_STATUS WHERE VARIABLE_NAME = 'wsrep_cluster_size';
--source include/wait_condition.inc

--error 0,1
--exec grep -oE "\[Note] WSREP: Initialization of the TLS service .*" -- $LOG_FILE_2
--error 0,1
--exec grep -oE "\[ERROR] WSREP: .*" -- $LOG_FILE_2

--remove_file $LOG_FILE_2

--source include/auto_increment_offset_restore.inc
