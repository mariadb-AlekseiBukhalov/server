SHOW CREATE TABLE information_schema.wsrep_bf_abort_history;
Table	Create Table
WSREP_BF_ABORT_HISTORY	CREATE TEMPORARY TABLE `WSREP_BF_ABORT_HISTORY` (
  `TIME` datetime(6) NOT NULL,
  `VICTIM_TRX_ID` bigint(21) unsigned,
  `VICTIM_THREAD_ID` bigint(21) unsigned NOT NULL,
  `VICTIM_QUERY_ID` bigint(21) unsigned NOT NULL,
  `VICTIM_SEQNO` bigint(21) unsigned,
  `VICTIM_CLIENT_STATE` varchar(32),
  `VICTIM_CLIENT_MODE` varchar(32),
  `VICTIM_TRX_STATE` varchar(32),
  `VICTIM_LOCK` varchar(128),
  `BF_TRX_ID` bigint(21) unsigned,
  `BF_THREAD_ID` bigint(21) unsigned NOT NULL,
  `BF_QUERY_ID` bigint(21) unsigned NOT NULL,
  `BF_SEQNO` bigint(21) unsigned,
  `BF_CLIENT_STATE` varchar(32),
  `BF_CLIENT_MODE` varchar(32),
  `BF_TRX_STATE` varchar(32),
  `BF_LOCK` varchar(128),
  `SPACE_ID` bigint(21) unsigned,
  `PAGE_NO` bigint(21) unsigned,
  `INDEX_NAME` varchar(512),
  `TABLE_NAME` varchar(512)
) ENGINE=MEMORY DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY, f2 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 10),(2, 20),(3, 30),(4, 40),(5,50);
connect node_1a, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connection node_1a;
BEGIN;
UPDATE t1 SET f2 = 100 WHERE f1 = 2;
connect node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connection node_1b;
BEGIN;
DELETE FROM t1 WHERE f1 = 4;
connect node_1c, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connection node_1c;
BEGIN;
UPDATE t1 SET F1 = 6, F2 = 60 WHERE f1 = 5;
connection node_2;
UPDATE t1 SET f2 = f2 * 100;
connection node_1a;
COMMIT;
