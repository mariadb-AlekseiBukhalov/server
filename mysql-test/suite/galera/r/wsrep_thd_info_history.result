SHOW CREATE TABLE information_schema.wsrep_thd_info_history;
Table	Create Table
WSREP_THD_INFO_HISTORY	CREATE TEMPORARY TABLE `WSREP_THD_INFO_HISTORY` (
  `ID` int(11) unsigned NOT NULL,
  `OS_THREAD_ID` bigint(21) unsigned NOT NULL,
  `TIME` datetime(6) NOT NULL,
  `MODE` varchar(32),
  `STATE` varchar(32),
  `TRANSACTION_ID` bigint(21) unsigned,
  `TRANSACTION_STATE` varchar(32),
  `SEQNO` bigint(21) unsigned,
  `DEPENDS_ON` bigint(21) unsigned,
  `GTID` varchar(512)
) ENGINE=MEMORY DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci
# Expect at least one applier
SELECT COUNT(*) > 0 AS expect_1 FROM information_schema.wsrep_thd_info_history WHERE MODE = "high priority";
expect_1
1
# Expect at least local connection
SELECT COUNT(*) > 0 AS expect_1 FROM information_schema.wsrep_thd_info_history WHERE MODE = "local";
expect_1
1
#
# Do some simple transactions to see their history
#
CREATE TABLE t1(a int not null primary key, b int) engine=INNODB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
UPDATE t1 set b = 5 where a = 3;
connection node_2;
#
# Do some simple transactions from second node to see their history
#
INSERT INTO t1 VALUES (4,4),(5,5),(6,6);
ALTER TABLE t1 ADD INDEX b(b);
connection node_1;
# Expect at least one local
SELECT COUNT(*) > 0 AS expect_1 FROM information_schema.wsrep_thd_info_history WHERE MODE = "local";
expect_1
1
