SELECT UNHEX(SUBSTRING_INDEX(SUBSTRING_INDEX(KEY_STRING, ' ', 1), ' ', -1)) as KEY_DATABASE,
UNHEX(SUBSTRING_INDEX(SUBSTRING_INDEX(KEY_STRING, ' ', 2), ' ', -1)) as KEY_TABLE,
SUBSTRING_INDEX(SUBSTRING_INDEX(KEY_STRING, ' ', 3), ' ', -1) as KEY_DATA,
KEY_STRING,
KEY_TYPE
FROM INFORMATION_SCHEMA.WSREP_CERT_KEYS
WHERE THD_ID = CONNECTION_ID()
ORDER BY KEY_STRING, KEY_TYPE;
