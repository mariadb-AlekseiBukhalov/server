--echo #
--echo # MENT-2418: Information Schema Table for the file_key_management plugin
--echo #

-- source include/not_embedded.inc

call mtr.add_suppression("file-key-management-filename is not set");
call mtr.add_suppression("Plugin 'file_key_management' init function returned error");
call mtr.add_suppression("Plugin 'file_key_management' registration.*failed");
call mtr.add_suppression("Plugin 'FILE_KEY_MANAGEMENT_KEYS' init function returned error.");
call mtr.add_suppression("Plugin 'FILE_KEY_MANAGEMENT_KEYS' registration as a INFORMATION SCHEMA failed.");

write_file $MYSQL_TMP_DIR/rotate_keys.txt;
1;526540c9854d26cea56a463e4ccff3ec59af70fb2f9f9e0acbff9af9c81dec91
2;dc315931aa81efc3ce085f3a2744d270ccfd67f4adc5e0d51ecc7362bcffb4f8
2;2;933a02ce942a2ce312e00462cd32ca045215842b20fce6f96c8fe7722da5dad2
EOF

--let $restart_parameters=--plugin-load-add=file_key_management --file-key-management-filename=$MYSQL_TMP_DIR/rotate_keys.txt
--let $restart_noprint=2
--source include/restart_mysqld.inc

SHOW FILE_KEY_MANAGEMENT_KEYS;
--sorted_result
SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

--echo # add new key
append_file $MYSQL_TMP_DIR/rotate_keys.txt;
1;2;c675d7268a20635bb179eae5b40eb57632913cf9ff0afb47c9b531f218bbec48
EOF

--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
FLUSH FILE_KEY_MANAGEMENT_KEYS;

SHOW FILE_KEY_MANAGEMENT_KEYS;
--sorted_result
SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

--echo # new keys, supplied in reverse-order of version: keyid=3, version=2
append_file $MYSQL_TMP_DIR/rotate_keys.txt;
3;2;07da0e6350562ce34613cf57cd11593595d19804c96757dcca47f0129a945c9a
3;1;95d19804c96757dcca47f0129a945c9b07da0e6350562ce34613cf57cd115935
EOF

--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
FLUSH FILE_KEY_MANAGEMENT_KEYS;

SHOW FILE_KEY_MANAGEMENT_KEYS;
--sorted_result
SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

--echo # check if keys exists after failed FLUSH
append_file $MYSQL_TMP_DIR/rotate_keys.txt;
4;0;07da0e6350562ce34613cf57cd1159945215842b20fce6f96c8fe7722da5dad2
EOF

call mtr.add_suppression('Invalid key version \\(version = 0\\)');
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--error 2
FLUSH FILE_KEY_MANAGEMENT_KEYS;

SHOW FILE_KEY_MANAGEMENT_KEYS;
--sorted_result
SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

--echo # verify access with users of different privileges
--echo # FLUSH requires RELOAD and SHOW requires PROCES

CREATE USER user@localhost;

GRANT ALL PRIVILEGES ON *.* TO user@localhost; # grant all & then revoke
REVOKE RELOAD ON *.* FROM user@localhost;
REVOKE PROCESS ON *.* FROM user@localhost;

CONNECT conn1, localhost, user, , test;

# should not show keyid, version
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
SHOW FILE_KEY_MANAGEMENT_KEYS;

SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
FLUSH FILE_KEY_MANAGEMENT_KEYS;

CONNECTION default;
DISCONNECT conn1;

# grant specific privileges
GRANT RELOAD ON *.* TO user@localhost;
GRANT PROCESS ON *.* TO user@localhost;
CONNECT conn1, localhost, user, , test;

# should show keyid, version
SHOW FILE_KEY_MANAGEMENT_KEYS;
--sorted_result
SELECT * FROM INFORMATION_SCHEMA.FILE_KEY_MANAGEMENT_KEYS;

# this is just to test privilege for FLUSH command
call mtr.add_suppression('Invalid key version \\(version = 0\\)');
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--error 2
FLUSH FILE_KEY_MANAGEMENT_KEYS;

CONNECTION default;
DISCONNECT conn1;

DROP USER user@localhost;
remove_file $MYSQL_TMP_DIR/rotate_keys.txt;
uninstall soname 'file_key_management';

--echo # End of 11.8 ES tests
