#
# MENT-2352: Implement key rotation for file_key_management plugin
#
call mtr.add_suppression("file-key-management-filename is not set");
call mtr.add_suppression("Plugin 'file_key_management' init function returned error");
call mtr.add_suppression("Plugin 'file_key_management' registration.*failed");
call mtr.add_suppression("Plugin 'FILE_KEY_MANAGEMENT_KEYS' init function returned error.");
call mtr.add_suppression("Plugin 'FILE_KEY_MANAGEMENT_KEYS' registration as a INFORMATION SCHEMA failed.");
# new keyfile format with version, mixed with old format
install soname 'file_key_management';
create table t1(c1 bigint not null, b char(200))  engine=innodb encrypted=yes encryption_key_id=2;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=2
insert t1 values (12345, repeat('1234567890', 20));
alter table t1 encryption_key_id=3;
ERROR HY000: Table storage engine 'InnoDB' does not support the create option 'ENCRYPTION_KEY_ID'
show warnings;
Level	Code	Message
Warning	140	InnoDB: ENCRYPTION_KEY_ID 3 not available
Error	1478	Table storage engine 'InnoDB' does not support the create option 'ENCRYPTION_KEY_ID'
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=2
drop table t1;
# append new key to keyfile, flush and use new keys
FLUSH FILE_KEY_MANAGEMENT_KEYS;
Warnings:
Note	1	Read from MYSQL_TMP_DIR/rotate_keys.txt, read bytes: 343, max key file size: 1048576 bytes
create table t1(c1 bigint not null, b char(200))  engine=innodb encrypted=yes encryption_key_id=3;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=3
insert t1 values (12345, repeat('1234567890', 20));
alter table t1 encryption_key_id=4;
ERROR HY000: Table storage engine 'InnoDB' does not support the create option 'ENCRYPTION_KEY_ID'
show warnings;
Level	Code	Message
Warning	140	InnoDB: ENCRYPTION_KEY_ID 4 not available
Error	1478	Table storage engine 'InnoDB' does not support the create option 'ENCRYPTION_KEY_ID'
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=3
drop table t1;
FOUND 1 /file_key_management: Reloading keys successful/ in mysqld.1.err
# check if keys are usable after a failed flush
create table t(c1 bigint not null, b char(200)) engine=innodb encrypted=yes encryption_key_id=2;
insert t values (12345, repeat('678', 5));
show create table t;
Table	Create Table
t	CREATE TABLE `t` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=2
call mtr.add_suppression('Invalid key version \\(version = 0\\)');
FLUSH FILE_KEY_MANAGEMENT_KEYS;
ERROR HY000: Invalid key version (version = 0) at MYSQL_TMP_DIR/rotate_keys.txt line 6, column 4
FOUND 1 /file_key_management: Failed to reload keys/ in mysqld.1.err
select * from t;
c1	b
12345	678678678678678
show create table t;
Table	Create Table
t	CREATE TABLE `t` (
  `c1` bigint(20) NOT NULL,
  `b` char(200) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci `encrypted`=yes `encryption_key_id`=2
uninstall soname 'file_key_management';
Warnings:
Warning	1620	Plugin is busy and will be uninstalled on shutdown
# End of 11.8 ES test
