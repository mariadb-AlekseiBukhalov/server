connection node_2;
connection node_1;
connection node_1;
connection node_2;
connect trx, 127.0.0.1, root, , test, $NODE_MYPORT_2;
connect trx_prepared, 127.0.0.1, root, , test, $NODE_MYPORT_2;
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);
connection trx;
SET SESSION wsrep_on = OFF;
XA START 'xatest';
connection trx_prepared;
SET SESSION wsrep_on = OFF;
XA START 'xatest_prepared';
INSERT INTO t1 VALUES (1);
XA END 'xatest_prepared';
XA PREPARE 'xatest_prepared';
connection node_2;
# restart
XA RECOVER;
formatID	gtrid_length	bqual_length	data
1	15	0	xatest_prepared
XA ROLLBACK 'xatest_prepared';
DROP TABLE t1;
call mtr.add_suppression('Found 1 prepared XA transactions');
call mtr.add_suppression('Discovered discontinuity in recovered wsrep transaction XIDs.');
