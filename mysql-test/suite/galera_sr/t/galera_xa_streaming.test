#
# Streaming within XA is currently not supported.
# Test that parameters wsrep_trx_fragment_size and
# wsrep_trx_fragment_unit are ignored by XA transactions.
#

--source include/galera_cluster.inc

CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);


#
# Test with wsrep_fragment_unit = 'bytes';
#

SET SESSION wsrep_trx_fragment_size = 1;
SET SESSION wsrep_trx_fragment_unit = 'bytes';
XA START 't';
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);

--connection node_2
SELECT COUNT(*) `expect 0` FROM mysql.wsrep_streaming_log;

--connection node_1
XA END 't';
XA PREPARE 't';
XA ROLLBACK 't';


#
# Test with wsrep_fragment_unit = 'statements';
#

SET SESSION wsrep_trx_fragment_size = 1;
SET SESSION wsrep_trx_fragment_unit = 'statements';
XA START 't';
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);

--connection node_2
SELECT COUNT(*) `expect 0` FROM mysql.wsrep_streaming_log;

--connection node_1
XA END 't';
XA PREPARE 't';
XA ROLLBACK 't';


#
# Test with wsrep_fragment_unit = 'rows';
#

SET SESSION wsrep_trx_fragment_size = 1;
SET SESSION wsrep_trx_fragment_unit = 'rows';
XA START 't';
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);

--connection node_2
SELECT COUNT(*) `expect 0` FROM mysql.wsrep_streaming_log;

--connection node_1
XA END 't';
XA PREPARE 't';
XA ROLLBACK 't';


#
# Can't change wsrep_trx_fragment_size during
# XA transaction
#

XA START 't';
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET SESSION wsrep_trx_fragment_size = 10;
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET SESSION wsrep_trx_fragment_size = DEFAULT;
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET GLOBAL wsrep_trx_fragment_size = 10;
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET GLOBAL wsrep_trx_fragment_size = DEFAULT;
XA END 't';
XA ROLLBACK 't';


#
# Can't change wsrep_trx_fragment_unit during
# XA transaction
#

XA START 't';
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET SESSION wsrep_trx_fragment_unit = 'rows';
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET SESSION wsrep_trx_fragment_unit = DEFAULT;
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET GLOBAL wsrep_trx_fragment_unit = 'rows';
--error ER_CANT_DO_THIS_DURING_AN_TRANSACTION
SET GLOBAL wsrep_trx_fragment_unit = DEFAULT;
XA END 't';
XA ROLLBACK 't';


# Subsequent transaction finds streaming enabled
START TRANSACTION;
INSERT INTO t1 VALUES (6);

--connection node_2
SELECT COUNT(*) `expect 1` FROM mysql.wsrep_streaming_log;

--connection node_1
COMMIT;

DROP TABLE t1;
