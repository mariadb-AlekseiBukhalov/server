#
# MENT-2306 XA transactions + Galera cluster as slaves + read_only nodes
# leads to failures to apply write sets.
#
# This is configured to setup two galera cluster, each made of two nodes.
# Node 3 and 4 are set read_only, and are meant to replicate the first
# cluster (node 1 and 2) through async replication.
#
--source include/galera_cluster.inc
--let $grp_skip_reason = XA not supported by Galera Plugin
--source include/not_galera_plugin.inc

--connect node_3, 127.0.0.1, root, , test, $NODE_MYPORT_3
--connect node_4, 127.0.0.1, root, , test, $NODE_MYPORT_4

#
# Connect node_3 to node_1 through async replication
#
--connection node_3
--disable_query_log
--eval CHANGE MASTER TO MASTER_HOST='127.0.0.1', MASTER_USER='root', MASTER_SSL_VERIFY_SERVER_CERT=0, MASTER_PORT=$NODE_MYPORT_1, master_use_gtid=current_pos;
--enable_query_log
START SLAVE;
--source include/wait_for_slave_to_start.inc

#
# Issue XA transaction from node_1
#
--connection node_1
CREATE TABLE t1 (f1 INTEGER PRIMARY KEY);

XA START 't';
INSERT INTO t1 VALUES (1);
XA END 't';
XA PREPARE 't';
XA COMMIT 't';

--sync_slave_with_master node_3

#
# If bug is present, transaction fails to apply to
# read_only nodes from second cluster, connected
# through async replication.
#
--connection node_3
SELECT * FROM t1;

--connection node_4
SELECT * FROM t1;

#
# Cleanup
#
--connection node_1
DROP TABLE t1;

--sync_slave_with_master node_3

--connection node_3

STOP SLAVE;
RESET SLAVE ALL;

--connection node_1
SET SESSION WSREP_ON=OFF;
RESET MASTER;
SET SESSION WSREP_ON=ON;

--source include/galera_end.inc
