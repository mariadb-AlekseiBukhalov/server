[provider-tcp]
loose-wsrep-debug=1
loose-wsrep-ssl-mode=PROVIDER

[provider-ssl]
loose-wsrep-debug=1
loose-wsrep-ssl-mode=PROVIDER
wsrep_provider_options=socket.ssl=yes;socket.ssl_cert=$MYSQL_TEST_DIR/std_data/cacert.pem;socket.ssl_key=$MYSQL_TEST_DIR/std_data/cakey.pem;evs.suspect_timeout=PT10S;evs.inactive_timeout=PT30S;evs.install_timeout=PT15S;pc.wait_prim_timeout=PT60S;gcache.size=10M

[server]
loose-wsrep-debug=1
loose-wsrep-ssl-mode=SERVER
loose-ssl-ca=$MYSQL_TEST_DIR/std_data/galera_certs/galera.root.crt
loose-ssl-key=$MYSQL_TEST_DIR/std_data/galera_certs/galera.1.key
loose-ssl-cert=$MYSQL_TEST_DIR/std_data/galera_certs/galera.1.crt

[server-x509]
wsrep-debug=1
wsrep-ssl-mode=SERVER_X509
loose-ssl-ca=$MYSQL_TEST_DIR/std_data/galera_certs/galera.root.crt
loose-ssl-key=$MYSQL_TEST_DIR/std_data/galera_certs/galera.1.key
loose-ssl-cert=$MYSQL_TEST_DIR/std_data/galera_certs/galera.1.crt
