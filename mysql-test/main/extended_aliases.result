v1	SET STATEMENT SQL_MODE='EXTENDED_ALIASES' FOR CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v1` AS select `t1`.`a` + 1 AS `d`,(select `t1`.`b` from `t1` where `d` = `t1`.`a`) AS `cc` from `t1`	latin1	latin1_swedish_ci
select * from v1;
d	cc
2	2
3	NULL
11	NULL
select a+1 as d, (select b from t1 where d=a) as cc from t1;
