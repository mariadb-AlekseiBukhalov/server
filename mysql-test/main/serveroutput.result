#
# MENT-2391 DBMS_OUTPUT on the client side
#
CREATE PROCEDURE p1()
BEGIN
SIGNAL SQLSTATE '01000' SET MESSAGE_TEXT = 'A warning occurred';
SELECT 'p1' AS msg;
CALL sys.DBMS_OUTPUT.PUT_LINE('line1');
CALL sys.DBMS_OUTPUT.PUT_LINE('line2');
CALL sys.DBMS_OUTPUT.PUT_LINE(NULL);
CALL sys.DBMS_OUTPUT.PUT_LINE('line3');
SELECT '/p1' AS msg;
END;
$$
#### Without output ####
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
CALL sys.DBMS_OUTPUT.GET_LINES_RESULT;
line
#### With output ####
CALL sys.DBMS_OUTPUT.ENABLE;
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
CALL sys.DBMS_OUTPUT.GET_LINES_RESULT;
line
line1
line2
NULL
line3
#### Without output ####
CALL sys.DBMS_OUTPUT.DISABLE;
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
CALL sys.DBMS_OUTPUT.GET_LINES_RESULT;
line
### With automatic output ####
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
line1
line2
NULL
line3
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
LINE1
line2
NULL
line3
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
line1
line2
NULL
line3
CALL p1;
msg	p1
msg	/p1
Warnings:
Level	Warning
Code	1642
Message	A warning occurred
line1
line2
NULL
line3
### Without automatic output ####
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
### Send/reap with and without automatic output ####
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
line1
line2
NULL
line3
CALL p1;
msg
p1
msg
/p1
Warnings:
Warning	1642	A warning occurred
DROP PROCEDURE p1;
